# Application
APP_NAME=FireLens API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database (PostgreSQL + PostGIS, accessed directly with asyncpg).
# Reuse the Supabase Session Pooler URL. Both schemes are accepted:
#   postgresql://...
#   postgresql+asyncpg://...
# URL-encode special characters in the password. Never commit the real .env.
# Set this to the real PostgreSQL/Supabase URL in `.env`; never commit it.
DATABASE_URL=postgresql://localhost:5432/postgres
DATABASE_POOL_MIN_SIZE=1
DATABASE_POOL_MAX_SIZE=10
DATABASE_CONNECT_TIMEOUT=15
DATABASE_COMMAND_TIMEOUT=30

# Frontend origins allowed by CORS (comma-separated, or * for local prototypes)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional. When set, GET /api/v1/exports/fires requires X-API-Key.
API_KEY=

# Used by ingestion jobs, not by the read-only API itself.
FIRMS_MAP_KEY=

# Limits and analytics methodology
DEFAULT_PAGE_SIZE=100
MAX_PAGE_SIZE=1000
MAX_CALENDAR_DAYS=366
HISTORICAL_MIN_YEARS=3
ANOMALY_MODERATE_THRESHOLD=2.5
ANOMALY_HIGH_THRESHOLD=3.5

# CSV streaming
EXPORT_BATCH_SIZE=500
EXPORT_CHUNK_SIZE=16384
